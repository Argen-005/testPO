{
  "name": "test-po",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:api": "jest api.test.js --verbose"
  },
  "dependencies": {
    "express": "^4.18.x"
  },
  "devDependencies": {
    "jest": "^29.x.x",
    "supertest": "^6.x.x"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}